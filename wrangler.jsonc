{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "newswatch-line",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-24",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "newswatch-line-db",
      "database_id": "local-d1-id"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "YOUTUBE_API_KEY": "AIzaSyDXAvI1BaA8wS2p0sv04BrqG-dvqj6GBns"
  },
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "observability": {
    "enabled": true
  }
}
